# CompliAI Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=CompliAI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# LLM Provider
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.0

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./compliai.db

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=compliai-v1
